<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cere Ofertă Lucrare — Platforma LEYA</title>
  <style>
    body { margin:0; font-family:'Segoe UI',sans-serif; background:#020617; color:#f8fafc; }
    .nav { display:flex; justify-content:space-between; align-items:center; padding:16px 28px; background:#0f172a; border-bottom:1px solid #1e293b; }
    .logo { font-weight:800; color:#fff; text-decoration:none; display:flex; align-items:center; gap:8px; }
    .logo span { background:#2563eb; padding:4px 8px; border-radius:6px; font-size:13px; }
    .wrap { max-width:760px; margin:36px auto; padding:0 16px; }
    .box { background:#0f172a; border:1px solid #1e293b; border-radius:16px; padding:28px; }
    .cats { display:grid; grid-template-columns:repeat(auto-fit, minmax(130px,1fr)); gap:10px; margin:16px 0 22px; }
    .cat { background:#1e293b; border:2px solid #334155; border-radius:10px; padding:12px; text-align:center; cursor:pointer; font-weight:600; font-size:13px; color:#e2e8f0; }
    .cat.activ { border-color:#10b981; background:rgba(16,185,129,0.15); color:#fff; }
    label { display:block; font-size:12px; color:#94a3b8; margin-bottom:5px; font-weight:600; }
    input, textarea { width:100%; padding:11px; border-radius:8px; border:1px solid #334155; background:#1e293b; color:#fff; margin-bottom:14px; box-sizing:border-box; font-family:inherit; }
    .btn { width:100%; padding:14px; border:none; border-radius:10px; background:#10b981; color:#fff; font-size:15px; font-weight:700; cursor:pointer; }
  </style>
</head>
<body>
  <nav class="nav">
    <a href="/" class="logo"><span>LY</span> PLATFORMA LEYA</a>
    <a href="/" style="color:#94a3b8; text-decoration:none; font-size:14px;">← Înapoi la Pagina Principală</a>
  </nav>
  <div class="wrap">
    <div class="box">
      <h1 style="margin:0 0 6px; font-size:24px;">Cere o ofertă pentru lucrarea ta de acasă</h1>
      <p style="margin:0 0 20px; color:#94a3b8; font-size:14px;">Alege serviciul dorit, completează detaliile, iar administratorul LEYA va calcula devizul și îl va trimite spre aprobare către o firmă verificată.</p>
      <label>1. Alege categoria de lucrare:</label>
      <div class="cats" id="lista-cat">
        <div class="cat activ" onclick="alegeCat(this, 'Curățenie Casă / Curte')"> Curățenie</div>
        <div class="cat" onclick="alegeCat(this, 'Construcții & Renovări')"> Construcții</div>
        <div class="cat" onclick="alegeCat(this, 'Garduri Metalice & Porți')"> Garduri</div>
        <div class="cat" onclick="alegeCat(this, 'Tâmplărie PVC & Geamuri')"> Tâmplărie PVC</div>
        <div class="cat" onclick="alegeCat(this, 'Acoperișuri & Tablă')"> Acoperișuri</div>
      </div>
      <label>2. Suprafață estimată (m² / ml) & Detalii lucrare:</label>
      <textarea id="c-detalii" rows="3" placeholder="Ex: Curățenie generală vilă 120 m² sau montaj gard metalic 35 ml..."></textarea>
      <label>3. Numele tău complet:</label>
      <input type="text" id="c-nume" placeholder="ex: Popescu Andrei">
      <label>4. Număr de telefon (pentru contact și echipa de execuție):</label>
      <input type="text" id="c-telefon" placeholder="ex: 0722123456">
      <label>5. E-mailul tău:</label>
      <input type="email" id="c-email" placeholder="ex: andrei@gmail.com">
      <label>6. Oraș / Județ (vizibil la aprobare):</label>
      <input type="text" id="c-oras" placeholder="ex: București / Ilfov">
      <label>7. Adresa exactă a lucrării (devine vizibilă firmei doar după aprobarea ofertei):</label>
      <input type="text" id="c-adresa" placeholder="ex: Str. Primăverii nr. 14">
      <button class="btn" onclick="trimiteCerereClient()">Trimite Cererea către Administratorul LEYA →</button>
    </div>
  </div>
  <script>
    let categorieAleasa = 'Curățenie Casă / Curte';
    function alegeCat(el, nume) {
      document.querySelectorAll('.cat').forEach(c => c.classList.remove('activ'));
      el.classList.add('activ');
      categorieAleasa = nume;
    }
    async function trimiteCerereClient() {
      const detalii = document.getElementById('c-detalii').value.trim();
      const nume = document.getElementById('c-nume').value.trim();
      const telefon = document.getElementById('c-telefon').value.trim();
      const email = document.getElementById('c-email').value.trim();
      const oras = document.getElementById('c-oras').value.trim();
      const adresa = document.getElementById('c-adresa').value.trim();
      if (!detalii || !nume || !telefon || !oras || !adresa) return alert('Te rugăm să completezi toate câmpurile obligatorii!');
      const r = await fetch('/api/cerere-client-simplu', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ categorie: categorieAleasa, detalii, nume, telefon, email, oras, adresa })
      });
      const rez = await r.json();
      alert(rez.mesaj);
      if (rez.succes) window.location.href = '/';
    }
  </script>
</body>
</html>